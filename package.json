{
  "name": "phu-quy-island",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run --maxWorkers=1 --minWorkers=1",
    "lint": "eslint src",
    "assets": "python3 scripts/asset_acquisition/acquire.py",
    "test:autonomous": "python3 -m unittest discover -s autonomous -p 'test_*.py'",
    "test:browser": "node scripts/testing/browser.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.181.2",
    "zustand": "4.5.7",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.181.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "6.4.1",
    "vitest": "3.2.4",
    "@playwright/test": "1.56.1"
  }
}
